\end{minipage}\hfill
\begin{minipage}[t]{0.42\linewidth}
\centering
\includegraphics[width=\linewidth]{fig/orlib_frontier_sp100.pdf}
\captionof{figure}{Kardinalno omejena fronta na primeru S\&P~100:
RD in SO v primerjavi z neomejeno fronto (USEF); vsaka točka
predstavlja eno vrednost parametra tveganja.}
\label{fig:orlib}
\end{minipage}
