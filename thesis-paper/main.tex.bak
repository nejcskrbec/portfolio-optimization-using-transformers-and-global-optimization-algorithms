\caption{All-Weather (5 skladov).}
\label{fig:leow-aw}
\end{subfigure}
\hfill
\begin{subfigure}{0.49\linewidth}
\centering
\includegraphics[width=\linewidth]{fig/equity_curve_leow_etf.pdf}
\caption{Razpršeni ETF (12 skladov).}
\label{fig:leow-etf}
\end{subfigure}
\caption{Gibanje vrednosti portfelja skozi zlom ob pandemiji
COVID-19: najboljši transformerski cevovod in zgodovinski pristop
v primerjavi s pasivnim indeksom S\&P~500. Vrednosti so bruto,
brez transakcijskih stroškov.}
\label{fig:leow}
\end{figure}

\begin{figure}[htbp]
\centering
\begin{subfigure}{0.49\linewidth}
\centering
\includegraphics[width=\linewidth]{fig/equity_curve_leow_sector.pdf}
\caption{Sektorji SPDR (11 skladov).}
\label{fig:leow-sector}
\end{subfigure}
\hfill
\begin{subfigure}{0.49\linewidth}
\centering
\includegraphics[width=\linewidth]{fig/equity_curve_leow_etf_faithful.pdf}
\caption{Razpršeni ETF -- zvest protokol (12 skladov).}
\label{fig:leow-etf-faithful}
